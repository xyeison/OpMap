{
  "expo": {
    "name": "VG Visitas",
    "slug": "op-map",
    "scheme": "opmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.vg.opmap.visitas",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VG Visitas usa tu ubicación al reportar una visita para mostrarte las sedes cercanas y confirmar que estás en el sitio.",
        "NSMicrophoneUsageDescription": "VG Visitas usa el micrófono para que dictes la visita. El audio se transcribe y no se guarda."
      }
    },
    "android": {
      "package": "co.vg.opmap.visitas",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VG Visitas usa tu ubicación al reportar una visita para mostrarte las sedes cercanas y confirmar que estás en el sitio.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "VG Visitas usa el micrófono para que dictes la visita. El audio se transcribe y no se guarda.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "493cb950-95c9-4fc9-823c-c4a5506a1b5b"
      }
    },
    "owner": "yjxms-team"
  }
}
