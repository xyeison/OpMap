# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side environment variables (for API routes)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key - MANTENER SECRETO, NO COMPARTIR
# Obtén este key desde Supabase: Settings → API → service_role
# Este key es necesario para operaciones administrativas que bypasean RLS
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Secreto para firmar la cookie de sesión (__Host-opmap_session en producción, opmap_session en
# desarrollo). OBLIGATORIO en producción y en Preview:
# sin él nadie puede iniciar sesión (fail closed). Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
SESSION_SECRET=

# Google Maps API (for client-side maps and distance calculations)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mapa base (teselas Leaflet). Vacío = Esri World Light Gray Base.
# Acepta cualquier plantilla Leaflet con {z}/{x}/{y} (también {s} y {r}), p. ej. CARTO con clave:
# https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_BASEMAP_URL=
# Atribución del proveedor de teselas (HTML permitido). Vacío = atribución de Esri por defecto.
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
