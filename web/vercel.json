{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "app/api/geojson/[type]/[id]/route.ts": {
      "maxDuration": 30
    },
    "app/api/recalculate-simplified/route.ts": {
      "maxDuration": 60
    },
    "app/api/kams/activate/route.ts": {
      "maxDuration": 60
    },
    "app/api/kams/deactivate/route.ts": {
      "maxDuration": 60
    },
    "app/api/routes/calculate-batch-secure/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/[fuente]/route.ts": {
      "maxDuration": 60
    },
    "app/api/fuentes/[fuente]/actualizar/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/secop_ii",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/secop_integrado",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/reps_sedes",
      "schedule": "0 8 2 * *"
    },
    {
      "path": "/api/cron/bdua",
      "schedule": "0 8 4 * *"
    },
    {
      "path": "/api/cron/minsalud_cifras",
      "schedule": "0 8 5 * *"
    },
    {
      "path": "/api/cron/continuar",
      "schedule": "30 9 * * *"
    }
  ]
}
